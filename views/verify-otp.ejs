<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify OTP - Realtime Messenger</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes shrink {
      from { width: 100%; }
      to { width: 0%; }
    }
    .animate-progress {
      animation: shrink 5000ms linear forwards;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex items-center justify-center p-4 antialiased">

  <!-- TOP-RIGHT FLASH TOAST CONTAINER -->
  <div id="flash-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 max-w-sm w-full pointer-events-none">
    <% if (flashMessages && (flashMessages.success?.length || flashMessages.error?.length || flashMessages.warn?.length)) { %>
      
      <% if (flashMessages.success && flashMessages.success.length > 0) { %>
        <% flashMessages.success.forEach(msg => { %>
          <div class="toast-card pointer-events-auto bg-white border border-emerald-200 shadow-xl rounded-xl overflow-hidden transition-all duration-300">
            <div class="p-4 flex items-start gap-3">
              <div class="text-emerald-500 flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div class="flex-1 text-sm font-medium text-slate-700"><%= msg %></div>
              <button onclick="dismissToast(this.closest('.toast-card'))" class="text-slate-400 hover:text-slate-600 font-bold text-lg leading-none">&times;</button>
            </div>
            <div class="h-1 bg-emerald-500 animate-progress"></div>
          </div>
        <% }) %>
      <% } %>

      <% if (flashMessages.warn && flashMessages.warn.length > 0) { %>
        <% flashMessages.warn.forEach(msg => { %>
          <div class="toast-card pointer-events-auto bg-white border border-amber-200 shadow-xl rounded-xl overflow-hidden transition-all duration-300">
            <div class="p-4 flex items-start gap-3">
              <div class="text-amber-500 flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              </div>
              <div class="flex-1 text-sm font-medium text-slate-700"><%= msg %></div>
              <button onclick="dismissToast(this.closest('.toast-card'))" class="text-slate-400 hover:text-slate-600 font-bold text-lg leading-none">&times;</button>
            </div>
            <div class="h-1 bg-amber-500 animate-progress"></div>
          </div>
        <% }) %>
      <% } %>

      <% if (flashMessages.error && flashMessages.error.length > 0) { %>
        <% flashMessages.error.forEach(msg => { %>
          <div class="toast-card pointer-events-auto bg-white border border-rose-200 shadow-xl rounded-xl overflow-hidden transition-all duration-300">
            <div class="p-4 flex items-start gap-3">
              <div class="text-rose-500 flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div class="flex-1 text-sm font-medium text-slate-700"><%= msg %></div>
              <button onclick="dismissToast(this.closest('.toast-card'))" class="text-slate-400 hover:text-slate-600 font-bold text-lg leading-none">&times;</button>
            </div>
            <div class="h-1 bg-rose-500 animate-progress"></div>
          </div>
        <% }) %>
      <% } %>

    <% } %>
  </div>

  <!-- MAIN CARD -->
  <main class="w-full max-w-md bg-white border border-slate-200 rounded-2xl shadow-xl p-8 space-y-6 text-center">
    
    <!-- ICON -->
    <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center mx-auto shadow-sm">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
    </div>

    <div>
      <h1 class="text-2xl font-bold text-slate-900">Check your email</h1>
      <p class="text-sm text-slate-500 mt-1">
        We sent a 4-digit verification code to <br/>
        <strong class="text-slate-700 font-medium"><%= email %></strong>
      </p>
    </div>

    <!-- OTP FORM -->
    <form action="/verify-otp" method="POST" id="otp-form" class="space-y-6">
      <input type="hidden" name="email" value="<%= email %>">
      <!-- Hidden combined OTP input -->
      <input type="hidden" name="otp" id="combined-otp">

      <!-- 4-DIGIT INPUT BOXES -->
      <div class="flex justify-center gap-3">
        <input type="text" maxlength="1" pattern="\d*" class="otp-input w-14 h-14 text-center text-2xl font-bold bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition" required />
        <input type="text" maxlength="1" pattern="\d*" class="otp-input w-14 h-14 text-center text-2xl font-bold bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition" required />
        <input type="text" maxlength="1" pattern="\d*" class="otp-input w-14 h-14 text-center text-2xl font-bold bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition" required />
        <input type="text" maxlength="1" pattern="\d*" class="otp-input w-14 h-14 text-center text-2xl font-bold bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition" required />
      </div>

      <!-- TIMER DISPLAY -->
      <div class="text-xs text-slate-500 font-medium">
        Code expires in: <span id="timer" class="text-indigo-600 font-bold">02:00</span>
      </div>

      <!-- SUBMIT BUTTON -->
      <button type="submit" class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all transform active:scale-[0.99]">
        Verify Code
      </button>
    </form>

    <!-- RESEND CODE OPTION -->
    <div class="pt-2 border-t border-slate-100">
      <p class="text-xs text-slate-500">
        Didn't receive code? 
        <form action="/resend-otp" method="POST" class="inline">
          <input type="hidden" name="email" value="<%= email %>">
          <button type="submit" id="resend-btn" disabled class="text-slate-400 font-semibold disabled:cursor-not-allowed cursor-pointer hover:underline">
            Resend OTP
          </button>
        </form>
      </p>
    </div>

  </main>

  <script>
    // Toast dismissal
    function dismissToast(el) {
      if (!el) return;
      el.classList.add('translate-x-full', 'opacity-0');
      setTimeout(() => el.remove(), 300);
    }
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.toast-card').forEach(t => setTimeout(() => dismissToast(t), 5000));
    });

    // 4-Digit Input auto-focus logic
    const inputs = document.querySelectorAll('.otp-input');
    const combinedInput = document.getElementById('combined-otp');
    const form = document.getElementById('otp-form');

    inputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        if (e.target.value.length === 1 && index < inputs.length - 1) {
          inputs[index + 1].focus();
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !e.target.value && index > 0) {
          inputs[index - 1].focus();
        }
      });
    });

    form.addEventListener('submit', (e) => {
      let otpValue = '';
      inputs.forEach(i => otpValue += i.value);
      combinedInput.value = otpValue;
    });

    // 2-Minute Live Countdown Timer
    let timeLeft = 120;
    const timerDisplay = document.getElementById('timer');
    const resendBtn = document.getElementById('resend-btn');

    const countdown = setInterval(() => {
      timeLeft--;
      let mins = Math.floor(timeLeft / 60);
      let secs = timeLeft % 60;
      timerDisplay.textContent = `${mins < 10 ? '0' : ''}${mins}:${secs < 10 ? '0' : ''}${secs}`;

      if (timeLeft <= 0) {
        clearInterval(countdown);
        timerDisplay.textContent = 'Expired';
        timerDisplay.classList.replace('text-indigo-600', 'text-rose-500');
        resendBtn.disabled = false;
        resendBtn.classList.replace('text-slate-400', 'text-indigo-600');
      }
    }, 1000);
  </script>
</body>
</html>