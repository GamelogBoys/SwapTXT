<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Messenger - Chats</title>
  <meta name="description" content="A real-time messaging application with secure OTP authentication, auto-expiring attachments, and instant messaging.">
  <meta name="theme-color" content="#ffffff" />
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/icons/icon-512.png">
  <link rel="icon" type="image/png" href="/icons/icon-192.png">
  <link rel="icon" type="image/png" href="/icons/icon-512.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/socket.io/socket.io.js"></script>
  <style>
    @keyframes shrink {
      from { width: 100% }
      to { width: 0% }
    }
    .animate-progress {
      animation: shrink 5000ms linear forwards
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 h-[100dvh] w-screen overflow-hidden flex flex-col antialiased">

  <div id="flash-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 max-w-sm w-full pointer-events-none">
    <% if (flashMessages && (flashMessages.success?.length || flashMessages.error?.length || flashMessages.warn?.length)) { %>
      <% if (flashMessages.success && flashMessages.success.length > 0) { %>
        <% flashMessages.success.forEach(msg => { %>
          <div class="toast-card pointer-events-auto bg-white border border-emerald-200 shadow-xl rounded-xl overflow-hidden transition-all duration-300">
            <div class="p-4 flex items-start gap-3">
              <div class="text-emerald-500 flex-shrink-0 mt-0.5"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
              <div class="flex-1 text-sm font-medium text-slate-700"><%= msg %></div>
              <button onclick="dismissToast(this.closest('.toast-card'))" class="text-slate-400 hover:text-slate-600 font-bold text-lg leading-none">&times;</button>
            </div>
            <div class="h-1 bg-emerald-500 animate-progress"></div>
          </div>
        <% }) %>
      <% } %>
      <% if (flashMessages.error && flashMessages.error.length > 0) { %>
        <% flashMessages.error.forEach(msg => { %>
          <div class="toast-card pointer-events-auto bg-white border border-rose-200 shadow-xl rounded-xl overflow-hidden transition-all duration-300">
            <div class="p-4 flex items-start gap-3">
              <div class="text-rose-500 flex-shrink-0 mt-0.5"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
              <div class="flex-1 text-sm font-medium text-slate-700"><%= msg %></div>
              <button onclick="dismissToast(this.closest('.toast-card'))" class="text-slate-400 hover:text-slate-600 font-bold text-lg leading-none">&times;</button>
            </div>
            <div class="h-1 bg-rose-500 animate-progress"></div>
          </div>
        <% }) %>
      <% } %>
      <% if (flashMessages.warn && flashMessages.warn.length > 0) { %>
        <% flashMessages.warn.forEach(msg => { %>
          <div class="toast-card pointer-events-auto bg-white border border-amber-200 shadow-xl rounded-xl overflow-hidden transition-all duration-300">
            <div class="p-4 flex items-start gap-3">
              <div class="text-amber-500 flex-shrink-0 mt-0.5"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg></div>
              <div class="flex-1 text-sm font-medium text-slate-700"><%= msg %></div>
              <button onclick="dismissToast(this.closest('.toast-card'))" class="text-slate-400 hover:text-slate-600 font-bold text-lg leading-none">&times;</button>
            </div>
            <div class="h-1 bg-amber-500 animate-progress"></div>
          </div>
        <% }) %>
      <% } %>
    <% } %>
  </div>

  <div class="flex h-full w-full max-w-7xl mx-auto bg-white shadow-xl overflow-hidden relative">
    
    <aside id="sidebar" class="w-full md:w-80 lg:w-96 border-r border-slate-200 flex flex-col bg-slate-50 flex-shrink-0 h-full">
      
      <div class="p-4 bg-white border-b border-slate-200 flex items-center justify-between flex-shrink-0">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-lg shadow-sm">
            <%= user.displayName.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h2 class="font-bold text-slate-800 leading-tight"><%= user.displayName %></h2>
            <span class="text-xs text-emerald-600 font-medium flex items-center gap-1">● Online</span>
          </div>
        </div>
        <div class="flex items-center gap-1">
          <button onclick="toggleNotifications()" class="relative p-2 text-slate-600 hover:bg-slate-100 rounded-xl transition" title="Notifications">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            <span id="notif-badge" class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-rose-500 rounded-full hidden"></span>
          </button>
          <button onclick="openAddContactModal()" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-xl transition" title="Add Contact by Email">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path></svg>
          </button>
        </div>
      </div>

      <div class="p-3 bg-white border-b border-slate-200 flex-shrink-0">
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </span>
          <input type="text" id="search-contacts" placeholder="Search chats..." oninput="filterContacts(this.value)"
            class="w-full pl-10 pr-4 py-2 bg-slate-100 border-none rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" />
        </div>
      </div>

      <div id="contacts-list" class="flex-1 overflow-y-auto divide-y divide-slate-100 min-h-0">
        <% if (contacts && contacts.length > 0) { %>
          <% contacts.forEach(contact => { %>
            <div onclick="selectChat('<%= contact.email %>', '<%= contact.displayName %>')" data-email="<%= contact.email %>"
              class="contact-item p-3.5 flex items-center gap-3 hover:bg-slate-100 cursor-pointer transition">
              <div class="relative flex-shrink-0">
                <div class="w-11 h-11 rounded-full bg-slate-200 text-slate-700 font-bold flex items-center justify-center">
                  <%= contact.displayName.charAt(0).toUpperCase() %>
                </div>
                <span class="status-dot absolute bottom-0 right-0 w-3 h-3 rounded-full bg-slate-400 border-2 border-white" data-contact-email="<%= contact.email %>"></span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <h4 class="font-semibold text-slate-900 text-sm truncate"><%= contact.displayName %></h4>
                </div>
                <p class="text-xs text-slate-500 truncate mt-0.5">Click to start messaging</p>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="p-8 text-center text-slate-400 text-sm">
            <p>No chats yet.</p>
            <p class="text-xs mt-1">Click the top-right <span class="font-bold">+</span> icon to add a contact by email.</p>
          </div>
        <% } %>
      </div>

    </aside>

    <main id="chat-area" class="hidden md:flex flex-1 flex-col bg-slate-50 absolute md:relative inset-0 z-20 md:z-auto h-full overflow-hidden">
      
      <div id="no-chat-selected" class="flex-1 flex flex-col items-center justify-center p-8 text-center text-slate-400 h-full">
        <div class="w-16 h-16 bg-slate-200 text-slate-500 rounded-2xl flex items-center justify-center mb-4">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-slate-700">Your Messages</h3>
        <p class="text-sm mt-1">Select a contact from the left sidebar to start chatting securely.</p>
      </div>

      <div id="active-chat-container" class="hidden flex-1 flex flex-col h-full overflow-hidden">
        
        <div class="p-4 bg-white border-b border-slate-200 flex items-center justify-between flex-shrink-0">
          <div class="flex items-center gap-3">
            <button onclick="closeActiveChat()" class="md:hidden p-1 text-slate-600 hover:text-slate-900">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </button>
            <div id="active-avatar" class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center">A</div>
            <div>
              <h3 id="active-name" class="font-bold text-slate-900 leading-tight">Contact Name</h3>
              <span id="active-status" class="text-xs text-slate-400">Offline</span>
            </div>
          </div>
          <a href="/logout" class="text-xs text-rose-500 font-semibold hover:underline">Log Out</a>
        </div>

        <div id="messages-box" class="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50 min-h-0"></div>

        <form id="message-form" onsubmit="sendMessage(event)" class="p-3 bg-white border-t border-slate-200 flex items-center gap-2 flex-shrink-0">
          <button type="button" onclick="openAttachmentModal()" class="p-2.5 text-slate-500 hover:bg-slate-100 rounded-xl transition" title="Add attachment">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          </button>
          <input type="text" id="message-input" placeholder="Type a message..." autocomplete="off"
            class="flex-1 px-4 py-2.5 bg-slate-100 border-none rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition" />
          <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow transition flex items-center gap-1.5 flex-shrink-0">
            <span>Send</span>
            <svg class="w-4 h-4 rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
          </button>
        </form>

      </div>

    </main>

  </div>

  <div id="notifications-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="font-bold text-lg text-slate-900">Notifications & Requests</h3>
        <button onclick="toggleNotifications()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
      </div>
      <div id="notifications-list" class="space-y-3 max-h-80 overflow-y-auto">
        <p class="text-sm text-slate-400 text-center py-4">No new notifications</p>
      </div>
    </div>
  </div>

  <div id="add-contact-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="font-bold text-lg text-slate-900">Add New Contact</h3>
        <button onclick="closeAddContactModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
      </div>
      <form action="/add-contact" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Contact Email Address</label>
          <input type="email" name="contactEmail" placeholder="friend@example.com" required
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none" />
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeAddContactModal()" class="px-4 py-2 text-sm text-slate-600 hover:bg-slate-100 rounded-xl font-medium">Cancel</button>
          <button type="submit" class="px-5 py-2 text-sm bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow">Send Invite</button>
        </div>
      </form>
    </div>
  </div>

  <div id="attachment-modal" class="fixed inset-0 bg-slate-900/55 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="font-bold text-lg text-slate-900">Send Attachment</h3>
        <button onclick="closeAttachmentModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
      </div>
      <form id="attachment-form" onsubmit="sendAttachment(event)" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Select File (Auto-deletes from server in 1 min)</label>
          <input type="file" id="attachment-file" required
            class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" />
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="closeAttachmentModal()" class="px-4 py-2 text-sm text-slate-600 hover:bg-slate-100 rounded-xl font-medium">Cancel</button>
          <button type="submit" class="px-5 py-2 text-sm bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold shadow">Upload & Send</button>
        </div>
      </form>
    </div>
  </div>

  <div id="image-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center z-50 p-4" onclick="closeImageModal()">
  <div class="relative max-w-4xl max-h-full flex items-center justify-center" onclick="event.stopPropagation()">
    <button onclick="closeImageModal()" class="absolute -top-12 right-0 text-white hover:text-slate-300 text-3xl font-bold leading-none">&times;</button>
    <img id="lightbox-img" src="" class="max-w-full max-h-[85vh] rounded-2xl shadow-2xl object-contain" />
  </div>
  <script>
    const currentUserEmail = "<%= user.email %>"
    const socket = io()
    let activeRecipientEmail = null
    let notifications = []
    const onlineStatusMap = new Map()

    function dismissToast(el) {
      if (!el) return
      el.classList.add('translate-x-full', 'opacity-0')
      setTimeout(() => el.remove(), 300)
    }
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.toast-card').forEach(t => setTimeout(() => dismissToast(t), 5000))
    })

    function openAddContactModal() {
      document.getElementById('add-contact-modal').classList.remove('hidden')
      document.getElementById('add-contact-modal').classList.add('flex')
    }
    function closeAddContactModal() {
      document.getElementById('add-contact-modal').classList.remove('flex')
      document.getElementById('add-contact-modal').classList.add('hidden')
    }

    function toggleNotifications() {
      const modal = document.getElementById('notifications-modal')
      if (modal.classList.contains('hidden')) {
        modal.classList.remove('hidden')
        modal.classList.add('flex')
      } else {
        modal.classList.remove('flex')
        modal.classList.add('hidden')
      }
    }

    function openAttachmentModal() {
      if (!activeRecipientEmail) {
        alert('Please select a chat first.')
        return
      }
      document.getElementById('attachment-modal').classList.remove('hidden')
      document.getElementById('attachment-modal').classList.add('flex')
    }

    function closeAttachmentModal() {
      document.getElementById('attachment-modal').classList.remove('flex')
      document.getElementById('attachment-modal').classList.add('hidden')
      document.getElementById('attachment-file').value = ''
    }

    async function sendAttachment(e) {
      e.preventDefault()
      const fileInput = document.getElementById('attachment-file')
      if (!fileInput.files[0] || !activeRecipientEmail) return

      const formData = new FormData()
      formData.append('file', fileInput.files[0])
      formData.append('recipientEmail', activeRecipientEmail)

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData
        })
        if (res.ok) {
          closeAttachmentModal()
        } else {
          alert('Failed to upload file.')
        }
      } catch (err) {
        console.error('Upload error:', err)
      }
    }

    socket.on('online_users_list', (emails) => {
      emails.forEach(email => onlineStatusMap.set(email, 'online'))
      updateAllStatusDots()
    })

    socket.on('user_status', ({ email, status }) => {
      onlineStatusMap.set(email, status)
      updateAllStatusDots()
      if (activeRecipientEmail === email) {
        const statusEl = document.getElementById('active-status')
        statusEl.textContent = status === 'online' ? 'Online' : 'Offline'
        statusEl.className = `text-xs font-medium ${status === 'online' ? 'text-emerald-600' : 'text-slate-400'}`
      }
    })

    function updateAllStatusDots() {
      document.querySelectorAll('.status-dot').forEach(dot => {
        const email = dot.getAttribute('data-contact-email')
        const status = onlineStatusMap.get(email) || 'offline'
        if (status === 'online') {
          dot.classList.remove('bg-slate-400')
          dot.classList.add('bg-emerald-500')
        } else {
          dot.classList.remove('bg-emerald-500')
          dot.classList.add('bg-slate-400')
        }
      })
    }

    socket.on('chat_invite', ({ senderEmail, senderName }) => {
      notifications.unshift({ type: 'invite', senderEmail, senderName })
      updateNotificationsUI()
      document.getElementById('notif-badge').classList.remove('hidden')
    })

    socket.on('invite_response_result', ({ accepted, responderName, responderEmail }) => {
      if (accepted) {
        notifications.unshift({ type: 'info', text: `${responderName} accepted your invitation!` })
        addContactToList(responderEmail, responderName)
      } else {
        notifications.unshift({ type: 'info', text: `${responderName} declined your invitation.` })
      }
      updateNotificationsUI()
      document.getElementById('notif-badge').classList.remove('hidden')
    })

    function updateNotificationsUI() {
      const list = document.getElementById('notifications-list')
      if (notifications.length === 0) {
        list.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">No new notifications</p>'
        document.getElementById('notif-badge').classList.add('hidden')
        return
      }
      list.innerHTML = ''
      notifications.forEach((notif, index) => {
        const div = document.createElement('div')
        div.className = 'p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-between gap-3'
        if (notif.type === 'invite') {
          div.innerHTML = `
            <div>
              <h4 class="font-bold text-sm text-slate-800">${notif.senderName}</h4>
              <p class="text-xs text-slate-500">${notif.senderEmail} sent you a chat invite.</p>
            </div>
            <div class="flex gap-2">
              <button onclick="respondInvite('${notif.senderEmail}', '${notif.senderName}', true, ${index})" class="px-3 py-1 bg-emerald-600 text-white text-xs font-semibold rounded-lg">Accept</button>
              <button onclick="respondInvite('${notif.senderEmail}', '${notif.senderName}', false, ${index})" class="px-3 py-1 bg-rose-600 text-white text-xs font-semibold rounded-lg">Decline</button>
            </div>
          `
        } else {
          div.innerHTML = `
            <div class="flex-1 text-sm text-slate-700">${notif.text}</div>
            <button onclick="removeNotif(${index})" class="text-slate-400 hover:text-slate-600 font-bold">&times;</button>
          `
        }
        list.appendChild(div)
      })
    }

    function respondInvite(senderEmail, senderName, accepted, index) {
      socket.emit('invite_response', { senderEmail, accepted })
      notifications.splice(index, 1)
      if (accepted) {
        addContactToList(senderEmail, senderName)
      }
      updateNotificationsUI()
    }

    function removeNotif(index) {
      notifications.splice(index, 1)
      updateNotificationsUI()
    }

    function addContactToList(email, name) {
      const list = document.getElementById('contacts-list')
      const existing = Array.from(list.querySelectorAll('.contact-item')).find(el => el.getAttribute('data-email') === email)
      if (existing) return

      const div = document.createElement('div')
      div.className = 'contact-item p-3.5 flex items-center gap-3 hover:bg-slate-100 cursor-pointer transition'
      div.setAttribute('data-email', email)
      div.setAttribute('onclick', `selectChat('${email}', '${name}')`)
      div.innerHTML = `
        <div class="relative flex-shrink-0">
          <div class="w-11 h-11 rounded-full bg-slate-200 text-slate-700 font-bold flex items-center justify-center">
            ${name.charAt(0).toUpperCase()}
          </div>
          <span class="status-dot absolute bottom-0 right-0 w-3 h-3 rounded-full bg-slate-400 border-2 border-white" data-contact-email="${email}"></span>
        </div>
        <div class="flex-1 min-w-0">
          <h4 class="font-semibold text-slate-900 text-sm truncate">${name}</h4>
          <p class="text-xs text-slate-500 truncate mt-0.5">Click to start messaging</p>
        </div>
      `
      list.prepend(div)
      updateAllStatusDots()
    }

    async function selectChat(email, name) {
      activeRecipientEmail = email
      document.getElementById('no-chat-selected').classList.add('hidden')
      document.getElementById('active-chat-container').classList.remove('hidden')
      document.getElementById('active-name').textContent = name
      document.getElementById('active-avatar').textContent = name.charAt(0).toUpperCase()

      const isOnline = onlineStatusMap.get(email) === 'online'
      const statusEl = document.getElementById('active-status')
      statusEl.textContent = isOnline ? 'Online' : 'Offline'
      statusEl.className = `text-xs font-medium ${isOnline ? 'text-emerald-600' : 'text-slate-400'}`

      if (window.innerWidth < 768) {
        document.getElementById('sidebar').classList.add('hidden')
        document.getElementById('chat-area').classList.remove('hidden')
        document.getElementById('chat-area').classList.add('flex')
      }

      const res = await fetch(`/api/messages/${email}`)
      const messages = await res.json()
      
      const box = document.getElementById('messages-box')
      box.innerHTML = ''
      messages.forEach(msg => appendMessage(msg))
      box.scrollTop = box.scrollHeight
    }

    function closeActiveChat() {
      activeRecipientEmail = null
      document.getElementById('sidebar').classList.remove('hidden')
      document.getElementById('chat-area').classList.remove('md:flex')
      document.getElementById('chat-area').classList.add('hidden')
    }

    function sendMessage(e) {
      e.preventDefault()
      const input = document.getElementById('message-input')
      const text = input.value.trim()
      if (!text || !activeRecipientEmail) return

      socket.emit('send_message', {
        recipientEmail: activeRecipientEmail,
        text
      })
      input.value = ''
    }

    socket.on('receive_message', (msg) => {
      if (msg.senderEmail === activeRecipientEmail || msg.recipientEmail === activeRecipientEmail) {
        appendMessage(msg)
        const box = document.getElementById('messages-box')
        box.scrollTop = box.scrollHeight
      } else {
        document.getElementById('notif-badge').classList.remove('hidden')
      }
    })

    function appendMessage(msg) {
      const box = document.getElementById('messages-box')
      const isMe = msg.senderEmail === currentUserEmail

      let contentHTML = `<p>${escapeHTML(msg.text)}</p>`
      if (msg.fileUrl) {
        if (msg.fileType && msg.fileType.startsWith('image/')) {
          contentHTML += `<div class="mt-2"><img src="${msg.fileUrl}" onclick="openImageModal('${msg.fileUrl}')" class="max-w-xs rounded-xl shadow-sm object-cover cursor-pointer hover:opacity-95 transition" /></div>`
        } else {
          contentHTML += `<div class="mt-2"><a href="${msg.fileUrl}" target="_blank" class="text-xs underline font-semibold flex items-center gap-1">📎 Download File</a></div>`
        }
      }

      const div = document.createElement('div')
      div.className = `flex ${isMe ? 'justify-end' : 'justify-start'} mb-2`
      div.innerHTML = `
        <div class="max-w-xs md:max-w-md px-4 py-2.5 rounded-2xl text-sm shadow-sm ${isMe ? 'bg-indigo-600 text-white rounded-br-none' : 'bg-white text-slate-800 border border-slate-200 rounded-bl-none'}">
          ${contentHTML}
          <span class="block text-[10px] ${isMe ? 'text-indigo-200' : 'text-slate-400'} text-right mt-1">${new Date(msg.createdAt || Date.now()).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
        </div>
      `
      box.appendChild(div)
    }

    function escapeHTML(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
      )
    }

    function filterContacts(query) {
      const items = document.querySelectorAll('.contact-item')
      items.forEach(item => {
        const name = item.querySelector('h4').textContent.toLowerCase()
        item.style.display = name.includes(query.toLowerCase()) ? 'flex' : 'none'
      })
    }
    function openImageModal(url) {
      const modal = document.getElementById('image-modal')
      const img = document.getElementById('lightbox-img')
      img.src = url
      modal.classList.remove('hidden')
      modal.classList.add('flex')
    }

    function closeImageModal() {
      const modal = document.getElementById('image-modal')
      modal.classList.remove('flex')
      modal.classList.add('hidden')
      document.getElementById('lightbox-img').src = ''
    }
  </script>
</div>
</body>
</html>